# Private and sensitive content
4-Private/*
3-Journal/*
!4-Private/README.md
!3-Journal/README.md

# Generated outputs (remove this line if you want to version-control outputs)
_output/*
!_output/README.md

# Environment and secrets
.env
.env.*
*.key
*.pem
credentials.json
secrets/

# Claude Code local overrides (machine-specific paths and personal preferences)
# settings.json is committed — it's the project-level recommended config for new users
.claude/settings.local.json

# Framework mode flag — create this file locally to enter framework mode (see CONTRIBUTING.md)
_config/.framework-mode

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Local tool installs (declared in _config/tools.md, installed on demand)
_tools/

# Node (if you add rendering later)
node_modules/
build/
dist/

# Python (if you add automation later)
__pycache__/
*.pyc
.venv/
venv/

# Obsidian (local state - don't commit)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace-override.json
.obsidian/plugins/
.obsidian/community-plugins.json
.obsidian/hotkeys.json

# Generated files
*.log

# OS files
Thumbs.db
Desktop.ini
